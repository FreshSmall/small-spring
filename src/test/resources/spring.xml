<?xml version="1.0" encoding="UTF-8"?>
<beans>

    <bean id="userService" class="com.test.framework.aop.UserService"/>

    <bean class="com.demo.framework.aop.framework.autoproxy.DefaultAdvisorAutoProxyCreator"/>

    <bean id="beforeAdvice" class="com.test.framework.aop.UserServiceBeforeAdvice"/>

    <bean id="methodInterceptor" class="com.demo.framework.aop.framework.adapter.MethodBeforeAdviceInterceptor">
        <property name="advice" ref="beforeAdvice"/>
    </bean>

    <!--<bean id="methodInterceptor" class="com.test.framework.aop.UserServiceInterceptor">
        <property name="advice" ref="beforeAdvice"/>
    </bean>-->

    <bean id="pointcutAdvisor" class="com.demo.framework.aop.aspectj.AspectJExpressionPointcutAdvisor">
        <property name="expression" value="execution(* com.test.framework.aop.IUserService.*(..))"/>
        <property name="advice" ref="methodInterceptor"/>
    </bean>

</beans>
